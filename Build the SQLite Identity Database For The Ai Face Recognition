import os
import sys

# 1. INJECT DLLS FIRST (Crucial so build_db.py can find the GPU)
cuda_bin = r"C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.4\bin\x64"
cudnn_bin = r"C:\Program Files\NVIDIA\CUDNN\v9.26\bin\13.4\x64"

if os.path.exists(cuda_bin):
    os.add_dll_directory(cuda_bin)
if os.path.exists(cudnn_bin):
    os.add_dll_directory(cudnn_bin)

# 2. NOW IMPORT EVERYTHING ELSE
import cv2
import sqlite3
import numpy as np
from insightface.app import FaceAnalysis

# 3. Initialize SCRFD + ArcFace on the GPU
print("Loading AI Models on GPU...")
app = FaceAnalysis(name='buffalo_l', providers=['CUDAExecutionProvider'])
app.prepare(ctx_id=0, det_size=(640, 640))

# 4. Setup SQLite Database (SAFE: Does NOT drop existing data)
db_path = "students.db"
conn = sqlite3.connect(db_path)
cursor = conn.cursor()

cursor.execute('''
    CREATE TABLE IF NOT EXISTS faces (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT UNIQUE,
        embedding BLOB
    )
''')
conn.commit()

# 5. Process the photos
photo_dir = "student_photos"
if not os.path.exists(photo_dir):
    os.makedirs(photo_dir)
    print(f"Created '{photo_dir}' folder. Please put images there and run again.")
    exit()

print("\nScanning photos and updating database...")
for filename in os.listdir(photo_dir):
    if not filename.lower().endswith(('.png', '.jpg', '.jpeg')):
        continue
        
    name = os.path.splitext(filename)[0]
    img_path = os.path.join(photo_dir, filename)
    
    # Read image
    img = cv2.imread(img_path)
    if img is None:
        print(f"❌ Failed to read {filename}")
        continue
        
    # Run Inference
    faces = app.get(img)
    
    if len(faces) == 0:
        print(f"❌ No face found in {filename}")
        continue
    elif len(faces) > 1:
        print(f"⚠️ Multiple faces found in {filename}. Using the largest one.")
        
    # Get the embedding of the largest face
    embedding = faces[0].embedding
    embedding_blob = embedding.tobytes()
    
    # INSERT OR REPLACE: Adds new people, or updates existing ones if you change their photo
    cursor.execute("""
        INSERT INTO faces (name, embedding) VALUES (?, ?)
        ON CONFLICT(name) DO UPDATE SET embedding=excluded.embedding
    """, (name, embedding_blob))
    print(f"✅ Successfully saved / updated: {name}")

conn.commit()
conn.close()
print(f"\nDone! Database updated in '{db_path}'")
