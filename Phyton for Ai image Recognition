from insightface.app import FaceAnalysis

# ---------------------------------------------------------
# 1. Load SQLite Embeddings
# ---------------------------------------------------------
print("Loading identity database from SQLite...")
conn = sqlite3.connect("students.db")
cursor = conn.cursor()
cursor.execute("SELECT name, embedding FROM faces")
rows = cursor.fetchall()
conn.close()

known_names = []
known_embeddings = []

for name, embedding_blob in rows:
    emb = np.frombuffer(embedding_blob, dtype=np.float32)
    known_names.append(name)
    known_embeddings.append(emb)

if known_embeddings:
    known_embeddings = np.array(known_embeddings)
    print(f"Loaded {len(known_names)} identities: {known_names}")
else:
    print("⚠️ Warning: No faces in SQLite database.")

# ---------------------------------------------------------
# 2. Shared Queues & AI Model Initialization
# ---------------------------------------------------------
input_queue = queue.Queue(maxsize=1)
output_queue = queue.Queue(maxsize=1)

print("Initializing AI Engine on GPU...")
app = FaceAnalysis(name='buffalo_l', providers=['CUDAExecutionProvider'])
# SPEED UPGRADE: Reduced det_size to 320x320. 
# This makes the AI process frames significantly faster while keeping the GPU load manageable.
app.prepare(ctx_id=0, det_size=(320, 320))

from collections import deque, Counter
import numpy as np

# ---------------------------------------------------------
# 3. AI Worker Thread (Background Processing + Multi-Frame Voting)
# ---------------------------------------------------------
latest_detections = [] 

def ai_worker():
    global latest_detections
    SIMILARITY_THRESHOLD = 0.45
    
    track_history = {}
    next_track_id = 0
    previous_targets = []  

    while True:
        frame = input_queue.get()
        if frame is None:
            break

        faces = app.get(frame)
        current_frame_detections = []
        current_targets = []

        # 🔥 FIX: Create a pool of available IDs for this specific frame
        available_prev_targets = previous_targets.copy()

        for face in faces:
            bbox = face.bbox.astype(int)
            embedding = face.embedding

            raw_identity = "Intruder"
            max_sim = 0.0

            if len(known_embeddings) > 0:
                dot_product = np.dot(known_embeddings, embedding)
                norms = np.linalg.norm(known_embeddings, axis=1) * np.linalg.norm(embedding)
                similarities = dot_product / norms

                best_match_idx = np.argmax(similarities)
                max_sim = similarities[best_match_idx]

                if max_sim >= SIMILARITY_THRESHOLD:
                    raw_identity = known_names[best_match_idx]

            # 🔥 FIX: Exclusive Distance Matching for Crowds
            center_x = (bbox[0] + bbox[2]) // 2
            center_y = (bbox[1] + bbox[3]) // 2
            
            assigned_id = None
            best_match_index = -1
            min_dist = 150  # Maximum pixels a face can move between frames
            
            # Find the absolute closest previous face
            for i, (prev_x, prev_y, tid) in enumerate(available_prev_targets):
                dist = np.hypot(center_x - prev_x, center_y - prev_y)
                if dist < min_dist:
                    min_dist = dist
                    best_match_index = i
                    assigned_id = tid
            
            if assigned_id is not None:
                # Remove it from the pool so another person nearby can't steal it
                available_prev_targets.pop(best_match_index)
            else:
                # If no previous face is close enough, they are a new arrival
                assigned_id = next_track_id
                next_track_id += 1

            current_targets.append((center_x, center_y, assigned_id))

            if assigned_id not in track_history:
                track_history[assigned_id] = deque(maxlen=7)
            
            track_history[assigned_id].append(raw_identity)

            vote_counts = Counter(track_history[assigned_id])
            voted_identity = vote_counts.most_common(1)[0][0]

            current_frame_detections.append((bbox, voted_identity, max_sim))

        previous_targets = current_targets

        if len(track_history) > 20:
            active_ids = {t[2] for t in current_targets}
            track_history = {k: v for k, v in track_history.items() if k in active_ids}

        latest_detections = current_frame_detections
        input_queue.task_done()# ---------------------------------------------------------
# 4. Main Thread: Camera & Display Window
# ---------------------------------------------------------
def main():
    global latest_detections
    
    ai_thread = threading.Thread(target=ai_worker, daemon=True)
    ai_thread.start()

    cap = cv2.VideoCapture("http://192.168.100.12:8080/video")
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

    if not cap.isOpened():
        print("❌ Error: Could not open camera.")
        return

    print("🎥 Live camera active. Real-time rendering on Main Thread...")

    while cap.isOpened():
        ret, frame = cap.read()
        if not ret:
            break

        frame = cv2.resize(frame, (1280, 720))

        # 1. Send a copy to the AI Worker in the background
        if not input_queue.full():
            try:
                input_queue.get_nowait() 
            except queue.Empty:
                pass
            input_queue.put(frame.copy())

        # 2. 🔥 NEW: Draw the latest known coordinates directly on the live feed
        for bbox, identity, max_sim in latest_detections:
            color = (0, 255, 0) if identity != "Intruder" else (0, 0, 255)
            cv2.rectangle(frame, (bbox[0], bbox[1]), (bbox[2], bbox[3]), color, 2)
            cv2.putText(frame, f"{identity} ({max_sim:.2f})", (bbox[0], bbox[1] - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)

        # 3. Show the frame instantly
        cv2.imshow("CCTV AI Stream (Ultra Low Latency)", frame)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
