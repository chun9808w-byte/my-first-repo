# =========================================================
# 1. CONFIGURATION
# =========================================================

CAMERA_SOURCE = "http://192.168.100.12:8080/video"

FRAME_WIDTH = 1280
FRAME_HEIGHT = 720

# AI processing rate
AI_FPS = 6.0

# Face detection / recognition
DETECTION_THRESHOLD = 0.40
SIMILARITY_THRESHOLD = 0.45

# Face quality
MIN_FACE_SIZE = 32
BLUR_THRESHOLD = 25.0

# Temporal confirmation
HISTORY_LENGTH = 7
MIN_CONFIRMATIONS = 4

# Motion detection
ENABLE_MOTION_GATE = True
MOTION_RESOLUTION = (320, 180)
MOTION_PIXEL_THRESHOLD = 20
MOTION_MIN_AREA = 500
MOTION_HOLD_SECONDS = 2.0

# Display
SHOW_SIMILARITY = True


# =========================================================
# 2. GLOBAL STATE
# =========================================================

# We only care about the newest camera frame.
input_queue = queue.Queue(maxsize=1)

latest_detections = []
detections_lock = threading.Lock()

stop_event = threading.Event()


# =========================================================
# 3. LOAD STUDENT EMBEDDINGS
# =========================================================

def load_student_embeddings(db_path="students.db"):
    print("[INFO] Loading identity database...")

    known_names = []
    known_embeddings = []

    if not os.path.exists(db_path):
        print("[WARNING] Database not found.")
        return known_names, np.empty((0, 512), dtype=np.float32)

    conn = sqlite3.connect(db_path)

    try:
        cursor = conn.cursor()
        cursor.execute("SELECT name, embedding FROM faces")
        rows = cursor.fetchall()
    finally:
        conn.close()

    for name, embedding_blob in rows:
        try:
            embedding = np.frombuffer(
                embedding_blob,
                dtype=np.float32
            ).copy()

            if embedding.size != 512:
                print(
                    f"[WARNING] Skipping {name}: "
                    f"expected 512 values, got {embedding.size}"
                )
                continue

            norm = np.linalg.norm(embedding)

            if norm == 0:
                continue

            # Normalize once when the database is loaded.
            embedding /= norm

            known_names.append(name)
            known_embeddings.append(embedding)

        except Exception as e:
            print(f"[WARNING] Failed loading {name}: {e}")

    if not known_embeddings:
        print("[WARNING] No valid embeddings found.")
        return known_names, np.empty((0, 512), dtype=np.float32)

    known_embeddings = np.asarray(
        known_embeddings,
        dtype=np.float32
    )

    print(f"[INFO] Loaded {len(known_names)} face embeddings.")
    print(f"[INFO] Identities: {sorted(set(known_names))}")

    return known_names, known_embeddings


known_names, known_embeddings = load_student_embeddings()


