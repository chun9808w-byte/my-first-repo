# =========================================================
# 5. MOTION DETECTOR
# =========================================================

class MotionDetector:

    def __init__(self):
        self.previous_gray = None
        self.last_motion_time = 0.0

    def detect(self, frame):
        small = cv2.resize(
            frame,
            MOTION_RESOLUTION
        )

        gray = cv2.cvtColor(
            small,
            cv2.COLOR_BGR2GRAY
        )

        gray = cv2.GaussianBlur(
            gray,
            (5, 5),
            0
        )

        if self.previous_gray is None:
            self.previous_gray = gray
            return False

        difference = cv2.absdiff(
            self.previous_gray,
            gray
        )

        _, threshold = cv2.threshold(
            difference,
            MOTION_PIXEL_THRESHOLD,
            255,
            cv2.THRESH_BINARY
        )

        threshold = cv2.dilate(
            threshold,
            None,
            iterations=2
        )

        contours, _ = cv2.findContours(
            threshold,
            cv2.RETR_EXTERNAL,
            cv2.CHAIN_APPROX_SIMPLE
        )

        motion_found = any(
            cv2.contourArea(contour) >= MOTION_MIN_AREA
            for contour in contours
        )

        self.previous_gray = gray

        if motion_found:
            self.last_motion_time = time.time()

        return (
            time.time() - self.last_motion_time
            < MOTION_HOLD_SECONDS
        )


# =========================================================
# 6. FACE QUALITY
# =========================================================

def face_is_good_quality(face, frame):
    """
    Reject faces that are too small or too blurry.
    Thresholds are intentionally fairly permissive for crowded scenes.
    """

    bbox = face.bbox.astype(int)

    x1 = max(0, bbox[0])
    y1 = max(0, bbox[1])
    x2 = min(frame.shape[1], bbox[2])
    y2 = min(frame.shape[0], bbox[3])

    width = x2 - x1
    height = y2 - y1

    if width < MIN_FACE_SIZE or height < MIN_FACE_SIZE:
        return False

    crop = frame[y1:y2, x1:x2]

    if crop.size == 0:
        return False

    gray = cv2.cvtColor(
        crop,
        cv2.COLOR_BGR2GRAY
    )

    blur_score = cv2.Laplacian(
        gray,
        cv2.CV_64F
    ).var()

    return blur_score >= BLUR_THRESHOLD


# =========================================================
# 7. FACE MATCHING
# =========================================================

def recognize_face(embedding):
    if len(known_embeddings) == 0:
        return "Unknown", 0.0

    embedding = embedding.astype(
        np.float32,
        copy=False
    )

    norm = np.linalg.norm(embedding)

    if norm == 0:
        return "Unknown", 0.0

    embedding = embedding / norm

    # Database vectors are already normalized, so dot product
    # is cosine similarity.
    similarities = np.dot(
        known_embeddings,
        embedding
    )

    best_index = int(np.argmax(similarities))
    best_similarity = float(similarities[best_index])

    if best_similarity >= SIMILARITY_THRESHOLD:
        return known_names[best_index], best_similarity

    return "Unknown", best_similarity


# =========================================================
# 8. SIMPLE TRACKING
# =========================================================

def calculate_center(bbox):
    x1, y1, x2, y2 = bbox

    return (
        (x1 + x2) // 2,
        (y1 + y2) // 2
    )


def assign_track_id(
    center,
    previous_targets,
    next_track_id,
    max_distance=150
):
    cx, cy = center

    best_id = None
    best_distance = float("inf")
    best_index = -1

    for i, (px, py, track_id) in enumerate(previous_targets):
        distance = np.hypot(
            cx - px,
            cy - py
        )

        if (
            distance < best_distance
            and distance < max_distance
        ):
            best_distance = distance
            best_id = track_id
            best_index = i

    if best_id is not None:
        remaining = [
            target
            for i, target in enumerate(previous_targets)
            if i != best_index
        ]

        return best_id, remaining

    return next_track_id, previous_targets


# =========================================================
# 9. AI WORKER
# =========================================================

def ai_worker():
    global latest_detections

    track_history = {}
    previous_targets = []

    next_track_id = 0
    last_ai_time = 0.0

    while not stop_event.is_set():

        try:
            frame = input_queue.get(timeout=0.2)
        except queue.Empty:
            continue

        now = time.time()

        # We use the queue only as a "latest frame" buffer and never call
        # queue.join(), so task_done() is intentionally not needed.
        if now - last_ai_time < 1.0 / AI_FPS:
            continue

        last_ai_time = now

        try:
            # ==========================================
            # FACE DETECTION
            # ==========================================

            faces = app.get(
                frame,
                max_num=0
            )

            current_targets = []
            current_detections = []

            available_previous = previous_targets.copy()

            for face in faces:

                # SCRFD already used DETECTION_THRESHOLD in app.prepare().
                # Keep this second check consistent with the same threshold.
                if hasattr(face, "det_score"):
                    if float(face.det_score) < DETECTION_THRESHOLD:
                        continue

                if not face_is_good_quality(face, frame):
                    continue

                bbox = face.bbox.astype(int)

                # ==========================================
                # FACE EMBEDDING
                # ==========================================

                embedding = face.normed_embedding

                if embedding is None:
                    continue

                # ==========================================
                # RECOGNITION
                # ==========================================

                raw_identity, similarity = recognize_face(
                    embedding
                )

                # ==========================================
                # TRACKING
                # ==========================================

                center = calculate_center(bbox)

                track_id, available_previous = assign_track_id(
                    center,
                    available_previous,
                    next_track_id
                )

                if track_id == next_track_id:
                    next_track_id += 1

                current_targets.append(
                    (
                        center[0],
                        center[1],
                        track_id
                    )
                )

                # ==========================================
                # TEMPORAL CONFIRMATION
                # ==========================================

                if track_id not in track_history:
                    track_history[track_id] = deque(
                        maxlen=HISTORY_LENGTH
                    )

                track_history[track_id].append(
                    raw_identity
                )

                vote_counts = Counter(
                    track_history[track_id]
                )

                candidate_identity, candidate_count = (
                    vote_counts.most_common(1)[0]
                )

                # Unknown can be displayed immediately.
                # A known student must appear enough times before
                # their name is confirmed.
                if candidate_identity == "Unknown":
                    display_identity = "Unknown"
                elif candidate_count >= MIN_CONFIRMATIONS:
                    display_identity = candidate_identity
                else:
                    display_identity = "Identifying..."

                # ==========================================
                # STORE RESULT
                # ==========================================

                current_detections.append(
                    {
                        "bbox": bbox,
                        "identity": display_identity,
                        "raw_identity": raw_identity,
                        "similarity": similarity,
                        "track_id": track_id,
                        "confirmations": candidate_count,
                        "timestamp": now
                    }
                )

            previous_targets = current_targets

            # Keep history only for tracks visible in the current AI frame.
            active_ids = {
                item[2]
                for item in current_targets
            }

            track_history = {
                track_id: history
                for track_id, history in track_history.items()
                if track_id in active_ids
            }

            with detections_lock:
                latest_detections = current_detections

        except Exception as e:
            print(
                f"[AI ERROR] {type(e).__name__}: {e}"
            )


# =========================================================
# 10. SEND ONLY LATEST FRAME
# =========================================================

def send_latest_frame(frame):
    """
    Keep only the newest frame so the AI does not build up latency.
    """

    if input_queue.full():
        try:
            input_queue.get_nowait()
        except queue.Empty:
            pass

    try:
        input_queue.put_nowait(
            frame.copy()
        )
    except queue.Full:
        pass


# =========================================================
# 11. DRAW RESULTS
# =========================================================

def draw_detections(
    frame,
    detections
):
    current_time = time.time()

    for detection in detections:

        # Do not draw old AI coordinates over a newer live frame.
        age = current_time - detection["timestamp"]

        if age > 0.5:
            continue

        bbox = detection["bbox"]
        identity = detection["identity"]
        similarity = detection["similarity"]

        x1, y1, x2, y2 = bbox

        if identity == "Unknown":
            color = (0, 0, 255)
        elif identity == "Identifying...":
            color = (0, 255, 255)
        else:
            color = (0, 255, 0)

        cv2.rectangle(
            frame,
            (x1, y1),
            (x2, y2),
            color,
            2
        )

        if SHOW_SIMILARITY:
            label = f"{identity} ({similarity:.2f})"
        else:
            label = identity

        text_y = max(
            25,
            y1 - 10
        )

        cv2.putText(
            frame,
            label,
            (x1, text_y),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            color,
            2
        )


# =========================================================
# 12. MAIN
# =========================================================

def main():
    global latest_detections

    motion_detector = MotionDetector()

    ai_thread = threading.Thread(
        target=ai_worker,
        daemon=True
    )

    ai_thread.start()

    print("[INFO] Opening camera...")

    cap = cv2.VideoCapture(
        CAMERA_SOURCE
    )

    cap.set(
        cv2.CAP_PROP_BUFFERSIZE,
        1
    )

    if not cap.isOpened():
        print("[ERROR] Could not open camera.")
        stop_event.set()
        return

    print("[INFO] Camera active.")
    print("[INFO] Press Q to exit.")

    fps_counter = 0
    fps_start = time.time()
    display_fps = 0.0

    motion_active = False
    previous_motion_state = False

    while not stop_event.is_set():

        ret, frame = cap.read()

        if not ret:
            print("[ERROR] Camera frame failed.")
            break

        frame = cv2.resize(
            frame,
            (FRAME_WIDTH, FRAME_HEIGHT)
        )

        # ==========================================
        # MOTION GATE
        # ==========================================

        if ENABLE_MOTION_GATE:
            motion_active = motion_detector.detect(
                frame
            )
        else:
            motion_active = True

        if motion_active:
            send_latest_frame(
                frame
            )

        # When the motion hold period ends, immediately remove
        # old face boxes instead of waiting for another AI result.
        if previous_motion_state and not motion_active:
            with detections_lock:
                latest_detections = []

        previous_motion_state = motion_active

        # ==========================================
        # GET + DRAW LATEST AI RESULT
        # ==========================================

        with detections_lock:
            detections_copy = list(
                latest_detections
            )

        draw_detections(
            frame,
            detections_copy
        )

        # ==========================================
        # STATUS
        # ==========================================

        status = (
            "AI ACTIVE"
            if motion_active
            else "STANDBY"
        )

        status_color = (
            (0, 255, 0)
            if motion_active
            else (0, 255, 255)
        )

        cv2.putText(
            frame,
            status,
            (20, 35),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            status_color,
            2
        )

        # ==========================================
        # DISPLAY FPS
        # ==========================================

        fps_counter += 1

        elapsed = time.time() - fps_start

        if elapsed >= 1.0:
            display_fps = fps_counter / elapsed
            fps_counter = 0
            fps_start = time.time()

        cv2.putText(
            frame,
            f"FPS: {display_fps:.1f}",
            (20, 70),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            (255, 255, 255),
            2
        )

        # ==========================================
        # DISPLAY
        # ==========================================

        cv2.imshow(
            "CCTV AI Surveillance",
            frame
        )

        key = cv2.waitKey(1) & 0xFF

        if key == ord("q"):
            break

    print("[INFO] Shutting down...")

    stop_event.set()

    cap.release()
    cv2.destroyAllWindows()

    ai_thread.join(
        timeout=2
    )

    print("[INFO] System stopped.")


# =========================================================
# ENTRY POINT
# =========================================================

if __name__ == "__main__":
    main()
