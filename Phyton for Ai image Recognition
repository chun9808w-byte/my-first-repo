import os
import sys 

# 1. INJECT DLLS FIRST
cuda_bin = r"C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.0\bin\x64"
cudnn_bin = r"C:\Program Files\NVIDIA\CUDNN\v9.26\bin\13.4\x64"

if os.path.exists(cuda_bin):
    os.add_dll_directory(cuda_bin)
if os.path.exists(cudnn_bin):
    os.add_dll_directory(cudnn_bin)

# 2. NOW IMPORT EVERYTHING ELSE
import cv2
import sqlite3
import numpy as np
import queue
import threading
import time
from insightface.app import FaceAnalysis

# ---------------------------------------------------------
# 1. Load SQLite Embeddings
# ---------------------------------------------------------
print("Loading identity database from SQLite...")
conn = sqlite3.connect("students.db")
cursor = conn.cursor()
cursor.execute("SELECT name, embedding FROM faces")
rows = cursor.fetchall()
conn.close()

known_names = []
known_embeddings = []

for name, embedding_blob in rows:
    emb = np.frombuffer(embedding_blob, dtype=np.float32)
    known_names.append(name)
    known_embeddings.append(emb)

if known_embeddings:
    known_embeddings = np.array(known_embeddings)
    print(f"Loaded {len(known_names)} identities: {known_names}")
else:
    print("⚠️ Warning: No faces in SQLite database.")

# ---------------------------------------------------------
# 2. Shared Queues & AI Model Initialization
# ---------------------------------------------------------
input_queue = queue.Queue(maxsize=1)
output_queue = queue.Queue(maxsize=1)

print("Initializing AI Engine on GPU...")
app = FaceAnalysis(name='buffalo_l', providers=['CUDAExecutionProvider'])
# SPEED UPGRADE: Reduced det_size to 320x320. 
# This makes the AI process frames significantly faster while keeping the GPU load manageable.
app.prepare(ctx_id=0, det_size=(320, 320))

# ---------------------------------------------------------
# 3. AI Worker Thread (Background Processing)
# ---------------------------------------------------------
def ai_worker():
    SIMILARITY_THRESHOLD = 0.45
    
    # SPEED UPGRADE: Cooldown reduced to 0.03 (allows up to ~30 AI analyzes per second)
    AI_COOLDOWN = 0.03 

    while True:
        frame = input_queue.get()
        if frame is None:
            break

        faces = app.get(frame)
        
        for face in faces:
            bbox = face.bbox.astype(int)
            embedding = face.embedding

            identity = "Intruder"
            max_sim = 0.0

            if len(known_embeddings) > 0:
                dot_product = np.dot(known_embeddings, embedding)
                norms = np.linalg.norm(known_embeddings, axis=1) * np.linalg.norm(embedding)
                similarities = dot_product / norms

                best_match_idx = np.argmax(similarities)
                max_sim = similarities[best_match_idx]

                if max_sim >= SIMILARITY_THRESHOLD:
                    identity = known_names[best_match_idx]

            color = (0, 255, 0) if identity != "Intruder" else (0, 0, 255)
            cv2.rectangle(frame, (bbox[0], bbox[1]), (bbox[2], bbox[3]), color, 2)
            cv2.putText(frame, f"{identity} ({max_sim:.2f})", (bbox[0], bbox[1] - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)

        if output_queue.full():
            try:
                output_queue.get_nowait()
            except queue.Empty:
                pass
        output_queue.put(frame)

        input_queue.task_done()
        time.sleep(AI_COOLDOWN)

# ---------------------------------------------------------
# 4. Main Thread: Camera & Display Window
# ---------------------------------------------------------
def main():
    ai_thread = threading.Thread(target=ai_worker, daemon=True)
    ai_thread.start()

    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        print("❌ Error: Could not open camera.")
        return

    latest_processed_frame = None
    print("🎥 Live camera active (Motion Detection Disabled). Real-time rendering on Main Thread...")

    while cap.isOpened():
        ret, frame = cap.read()
        if not ret:
            break

        # MOTION DETECTION REMOVED: We now feed every single frame to the AI instantly.
        if input_queue.full():
            try:
                input_queue.get_nowait() 
            except queue.Empty:
                pass
        input_queue.put(frame.copy())

        # Retrieve latest processed frame from AI worker if available
        if not output_queue.empty():
            latest_processed_frame = output_queue.get_nowait()

        # Display processed frame if available, otherwise raw camera feed
        display_frame = latest_processed_frame if latest_processed_frame is not None else frame

        cv2.imshow("CCTV AI Stream (Ultra Low Latency)", display_frame)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
